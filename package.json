{
  "name": "why-now",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "docker compose up -d --wait && next build && next start",
    "up": "npm ci && npm start",
    "lint": "eslint",
    "test": "docker compose up -d --wait db_test && vitest run",
    "verify": "node e2e/verify.mjs",
    "e2e": "playwright test",
    "e2e:xem": "node e2e/headed.mjs",
    "e2e:report": "playwright show-report",
    "seed": "docker compose up -d --wait && prisma generate && prisma migrate deploy && tsx --env-file=.env prisma/seed.ts",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "postinstall": "prisma generate",
    "stop": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.232",
    "@fluentui/react-components": "9.74.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "fflate": "^0.8.3",
    "next": "^16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9",
    "typescript-eslint": "8.67.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
