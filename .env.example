# Mẫu — chép thành `.env` rồi sửa. `.env` bị gitignore.
#
# `AD-15`: env chỉ chứa BÍ MẬT và ĐỊA CHỈ HẠ TẦNG. Mọi tham số nghiệp vụ nằm
# ở bảng `settings` và sửa được lúc chạy (`D38`) — đừng thêm ngưỡng, trần,
# hay chu kỳ vào đây.

# ── Hạ tầng ──
# Khớp docker-compose.yml. Cổng 5442 = demo, 5443 = kiểm thử. KHÔNG dùng 5432/5433 mặc định:
# máy nào có sẵn Postgres hoặc dự án khác đang chạy sẽ đụng cổng, và
# `docker compose up -d` đỏ ngay ở cổng nộp bài §7.3.
DATABASE_URL="postgresql://whynow:whynow@localhost:5442/whynow?schema=public"
TEST_DATABASE_URL="postgresql://whynow:whynow@localhost:5443/whynow_test?schema=public"

# ── Tầng AI ──
# ĐỂ TRỐNG là có chủ đích. Agent SDK khi đó dùng credential subscription ở
# `~/.claude` — đúng cách đội đã đo ngày 14/08.
#
# Đường lui, nếu đường subscription hỏng sáng 15/08: điền khoá vào đây.
# Đó là TOÀN BỘ việc phải làm — không sửa một dòng mã nào (`AD-AG-8`).
ANTHROPIC_API_KEY=

# ── Ngoại lệ duy nhất của luật "env chỉ chứa bí mật và hạ tầng" ──
# `§7.3` của đề bài xếp chu kỳ vòng quét vào biến môi trường, còn `D38` đòi
# sửa được lúc chạy. Giải: env là GIÁ TRỊ KHỞI TẠO, bảng `settings` ghi đè
# lúc chạy. Ghi ở đây vì nó là chỗ duy nhất hai nguồn cấu hình cùng chạm một
# giá trị (`AD-15`).
SCAN_INTERVAL_MINUTES=1

# ── Tầng ② Agent Runtime (`AD-15`) ──────────────────────────────────────────
# Cả ba có mặc định trong `src/config.ts`; để trống là dùng mặc định.
# `AGENT_MAX_BUDGET_USD` là trần cho MỘT lời gọi query(), KHÔNG phải trần vòng
# quét — trần vòng quét là `scan_budget_usd` ở bảng `settings`.
AGENT_MODEL_ID=
AGENT_MAX_TURNS=
AGENT_MAX_BUDGET_USD=
