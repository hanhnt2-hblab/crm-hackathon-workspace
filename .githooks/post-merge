#!/bin/sh
# Sau khi merge, nếu skill BMad thay đổi thì kiểm lại phần nhúng BABOK.
# Hub nằm ở ~/.claude/skills/babok-business-analysis (junction sang repo nguồn).

if git diff-tree -r --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q "^\.claude/skills/bmad-"; then
  HUB="$HOME/.claude/skills/babok-business-analysis"
  if [ ! -d "$HUB" ]; then
    echo "⚠ Không thấy hub babok-business-analysis — bỏ qua phần kiểm BABOK."
    exit 0
  fi
  echo "→ BMad thay đổi, kiểm lại phần nhúng BABOK…"
  python "$HUB/install.py" --project-root . --quiet
  python "$HUB/verify.py" --project-root . || {
    echo "⚠ verify báo lệch — đọc output ở trên trước khi làm tiếp."
  }
fi
