{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/masthead/**",
              "components/reading/**",
              "components/signals/**",
              "components/suggestions/**",
              "components/worklist/**",
              "ui_kits/why-now/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Serif))/i]",
        "message": "Font not provided by the design system. Available: Noto Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIOffBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:since|reason|canResume|onResume|key|ref|className|style|children)$/]",
        "message": "<AIOffBanner> doesn't accept that prop. Declared props: since, reason, canResume, onResume."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|glyph|disabled|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, glyph, disabled, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|suggestion|danger|onMachine)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'suggestion' | 'danger' | 'onMachine'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|block)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'block'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|onMachine|key|ref|className|style|children)$/]",
        "message": "<ConfidenceBadge> doesn't accept that prop. Declared props: level, onMachine."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceBadge'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:chac|cothe|doan)$/]",
        "message": "<ConfidenceBadge> level must be one of 'chac' | 'cothe' | 'doan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DismissReasonPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:reasons|onPick|key|ref|className|style|children)$/]",
        "message": "<DismissReasonPicker> doesn't accept that prop. Declared props: reasons, onPick."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:line|sub|children|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: line, sub, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:swatch|text|key|ref|className|style|children)$/]",
        "message": "<LegendItem> doesn't accept that prop. Declared props: swatch, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendItem'] > JSXAttribute[name.name='swatch'] > Literal[value!=/^(?:machine|paper)$/]",
        "message": "<LegendItem> swatch must be one of 'machine' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Masthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:view|user|date|currency|stats|nav|activeNav|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Masthead> doesn't accept that prop. Declared props: view, user, date, currency, stats, nav, activeNav, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|compare|insufficient|insufficientNote|tone|key|ref|className|style|children)$/]",
        "message": "<Metric> doesn't accept that prop. Declared props: label, value, compare, insufficient, insufficientNote, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|warn)$/]",
        "message": "<Metric> tone must be one of 'default' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewItemsBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|noun|scanAt|onLoad|key|ref|className|style|children)$/]",
        "message": "<NewItemsBanner> doesn't accept that prop. Declared props: count, noun, scanAt, onLoad."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartialError'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|retryLabel|onRetry|key|ref|className|style|children)$/]",
        "message": "<PartialError> doesn't accept that prop. Declared props: title, detail, retryLabel, onRetry."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueCalloutItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|confidence|key|ref|className|style|children)$/]",
        "message": "<QueueCalloutItem> doesn't accept that prop. Declared props: text, confidence."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueCalloutItem'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:chac|cothe|doan)$/]",
        "message": "<QueueCalloutItem> confidence must be one of 'chac' | 'cothe' | 'doan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|lang|source|onMachine|onOpen|key|ref|className|style|children)$/]",
        "message": "<QuoteBlock> doesn't accept that prop. Declared props: quote, lang, source, onMachine, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionKicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|tone|key|ref|className|style|children)$/]",
        "message": "<SectionKicker> doesn't accept that prop. Declared props: title, meta, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionKicker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|overdue)$/]",
        "message": "<SectionKicker> tone must be one of 'default' | 'overdue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|date|onMachine|onOpen|key|ref|className|style|children)$/]",
        "message": "<SignalChip> doesn't accept that prop. Declared props: kind, date, onMachine, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkeletonRows'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|key|ref|className|style|children)$/]",
        "message": "<SkeletonRows> doesn't accept that prop. Declared props: count."
      },
      {
        "selector": "JSXOpeningElement[name.name='SnapshotParagraph'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|marked|key|ref|className|style|children)$/]",
        "message": "<SnapshotParagraph> doesn't accept that prop. Declared props: text, marked."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceByline'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|detail|key|ref|className|style|children)$/]",
        "message": "<SourceByline> doesn't accept that prop. Declared props: source, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceByline'] > JSXAttribute[name.name='source'] > Literal[value!=/^(?:machine|human)$/]",
        "message": "<SourceByline> source must be one of 'machine' | 'human'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StagePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:stage|onMachine|key|ref|className|style|children)$/]",
        "message": "<StagePill> doesn't accept that prop. Declared props: stage, onMachine."
      },
      {
        "selector": "JSXOpeningElement[name.name='StagePill'] > JSXAttribute[name.name='stage'] > Literal[value!=/^(?:Tiếp cận|Đủ điều kiện|Soạn đề xuất|Thương lượng|Thắng|Thua|Tạm dừng)$/]",
        "message": "<StagePill> stage must be one of 'Tiếp cận' | 'Đủ điều kiện' | 'Soạn đề xuất' | 'Thương lượng' | 'Thắng' | 'Thua' | 'Tạm dừng'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|note|children|key|ref|className|style|children)$/]",
        "message": "<StatBox> doesn't accept that prop. Declared props: title, sub, note, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|value|closed|last|key|ref|className|style|children)$/]",
        "message": "<StatRow> doesn't accept that prop. Declared props: name, count, value, closed, last."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:account|field|current|proposed|confidence|quote|quoteLang|quoteSource|risk|staleProfile|onApprove|onEditApprove|onDismiss|onOpenSource|key|ref|className|style|children)$/]",
        "message": "<SuggestionCard> doesn't accept that prop. Declared props: account, field, current, proposed, confidence, quote, quoteLang, quoteSource, risk, staleProfile, onApprove, onEditApprove, onDismiss, onOpenSource."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionCard'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:chac|cothe|doan)$/]",
        "message": "<SuggestionCard> confidence must be one of 'chac' | 'cothe' | 'doan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionPin'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|onMachine|onClick|key|ref|className|style|children)$/]",
        "message": "<SuggestionPin> doesn't accept that prop. Declared props: count, onMachine, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|optional|multiline|rows|value|onChange|placeholder|id|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, optional, multiline, rows, value, onChange, placeholder, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:when|bySystem|author|last|children|key|ref|className|style|children)$/]",
        "message": "<TimelineEntry> doesn't accept that prop. Declared props: when, bySystem, author, last, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='UndoButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:remaining|soon|note|onUndo|key|ref|className|style|children)$/]",
        "message": "<UndoButton> doesn't accept that prop. Declared props: remaining, soon, note, onUndo."
      },
      {
        "selector": "JSXOpeningElement[name.name='WarningFlag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|glyph|children|key|ref|className|style|children)$/]",
        "message": "<WarningFlag> doesn't accept that prop. Declared props: tone, glyph, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='WarningFlag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warn|stale|quiet)$/]",
        "message": "<WarningFlag> tone must be one of 'warn' | 'stale' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|when|whenDetail|overdue|flagged|account|accountMeta|accountAdornment|opportunity|stage|headline|bylineDetail|money|confidence|signalMeta|children|key|ref|className|style|children)$/]",
        "message": "<WorkItem> doesn't accept that prop. Declared props: source, when, whenDetail, overdue, flagged, account, accountMeta, accountAdornment, opportunity, stage, headline, bylineDetail, money, confidence, signalMeta, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkItem'] > JSXAttribute[name.name='source'] > Literal[value!=/^(?:machine|human)$/]",
        "message": "<WorkItem> source must be one of 'machine' | 'human'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkItem'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:chac|cothe|doan)$/]",
        "message": "<WorkItem> confidence must be one of 'chac' | 'cothe' | 'doan'."
      }
    ]
